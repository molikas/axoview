{
  "name": "axoview",
  "version": "3.7.0",
  "private": true,
  "description": "An open-source React component for drawing network diagrams — forked from FossFLOW, which was forked from Isoflow.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/molikas/axoview"
  },
  "main": "./dist/index.js",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "rslib build --watch",
    "dev": "rslib build --watch",
    "build": "rslib build && tsc --project tsconfig.declaration.json && tsc-alias",
    "build:watch": "rslib build --watch",
    "test": "npx --no-install jest",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "chroma-js": "^3.3.0",
    "dom-to-image-more": "^3.11.0",
    "dompurify": "^3.5.0",
    "immer": "^11.2.10",
    "mui-color-input": "^9.0.0",
    "pathfinding": "^0.4.18",
    "react-quill-new": "^3.8.3",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@isoflow/isopacks": "^0.0.10",
    "@rsbuild/core": "^1.7.6",
    "@rsbuild/plugin-react": "^1.4.6",
    "@rslib/core": "^0.20.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/chroma-js": "^3.1.3",
    "@types/jest": "^29.5.14",
    "@types/jsdom": "^30.0.0",
    "@types/pathfinding": "^0.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-jest": "^29.4.15",
    "tsc-alias": "^1.9.10"
  }
}
