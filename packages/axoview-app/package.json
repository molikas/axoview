{
  "name": "axoview-app",
  "version": "3.7.0",
  "private": true,
  "description": "Progressive Web App for creating isometric diagrams",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@isoflow/isopacks": "^0.0.10",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@react-oauth/google": "^0.13.5",
    "axoview": "*",
    "i18next": "^27.2.7",
    "i18next-browser-languagedetector": "^8.3.1",
    "i18next-http-backend": "^4.1.1",
    "jszip": "^3.10.2",
    "react": "^19.3.1",
    "react-arborist": "^3.16.0",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-i18next": "^18.0.3",
    "react-quill-new": "^3.8.3",
    "react-router-dom": "^7.18.7",
    "zustand": "^5.1.0"
  },
  "scripts": {
    "prebuild": "node scripts/generateMaterialIconPack.js && cd ../.. && npm run build:lib",
    "prestart": "node scripts/generateMaterialIconPack.js",
    "start": "rsbuild dev",
    "build": "rsbuild build",
    "preview": "rsbuild preview",
    "preview:r1": "node scripts/preview-r1.mjs",
    "og:image": "node scripts/generate-og-image.mjs",
    "clean": "rm -rf build",
    "lint": "tsc --noEmit",
    "test": "npx --no-install jest"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@rsbuild/core": "^1.7.6",
    "@rsbuild/plugin-react": "^1.4.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.4.15"
  }
}
